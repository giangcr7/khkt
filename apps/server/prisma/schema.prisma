// 1. Cấu hình kết nối
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////////////////////////
// USER & AUTH
/////////////////////////////////////////////////

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  fullName String
  avatar   String?
  role     Role    @default(STUDENT)
  isActive Boolean @default(true)

  // Quan hệ
  ownedProjects    Project[]       @relation("StudentProjects")
  mentoredProjects Project[]       @relation("MentorProjects")
  projectMembers   ProjectMember[]
  posts            Post[]
  notifications    Notification[]

  // SỬA TẠI ĐÂY: Chỉ giữ lại một quan hệ đến Recruitment
  recruitments Recruitment[] @relation("UserRecruitments")

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/////////////////////////////////////////////////
// PROJECT CORE
/////////////////////////////////////////////////
model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PENDING)

  // Thay vì dùng String, ta dùng quan hệ với bảng Topic
  topicId Int?
  topic   Topic? @relation(fields: [topicId], references: [id])

  progress Int     @default(0)
  score    Float?
  feedback String? @db.Text

  reportUrl String?
  slideUrl  String?

  startDate DateTime?
  endDate   DateTime?

  studentId Int
  student   User @relation("StudentProjects", fields: [studentId], references: [id])

  mentorId Int?
  mentor   User? @relation("MentorProjects", fields: [mentorId], references: [id])

  members      ProjectMember[]
  progressLogs ProjectProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/////////////////////////////////////////////////
// PROJECT MEMBERS (NHÓM NGHIÊN CỨU)
/////////////////////////////////////////////////

model ProjectMember {
  id        Int        @id @default(autoincrement())
  projectId Int
  userId    Int
  role      MemberRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([projectId, userId])
}

/////////////////////////////////////////////////
// PROJECT PROGRESS (TIẾN ĐỘ)
/////////////////////////////////////////////////

model ProjectProgress {
  id        Int     @id @default(autoincrement())
  projectId Int
  title     String
  content   String? @db.Text
  percent   Int

  // --- THÊM TRƯỜNG NÀY ---
  fileUrl  String? // Đường dẫn file minh chứng (S3, Cloudinary hoặc Local)
  fileName String? // Tên file để hiển thị ở giao diện
  // --------------------

  feedback  String?  @db.Text
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////
// CMS - POSTS
/////////////////////////////////////////////////

model Post {
  id           Int     @id @default(autoincrement())
  title        String
  content      String? @db.Text
  thumbnail    String?
  externalLink String?

  type        PostType @default(NEWS)
  isPublished Boolean  @default(true)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  topic     Topic?   @relation(fields: [topicId], references: [id])
  topicId   Int?
}

/////////////////////////////////////////////////
// RESOURCES (KHO TÀI LIỆU)
/////////////////////////////////////////////////

model Resource {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  fileUrl     String
  type        ResourceType

  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////
// EVENTS (TIMELINE NCKH)
/////////////////////////////////////////////////

model Event {
  id          Int       @id @default(autoincrement())
  title       String // VD: "Hạn chót nộp thuyết minh đề tài"
  description String?   @db.Text
  startDate   DateTime // Ngày bắt đầu/Ngày diễn ra
  endDate     DateTime? // Ngày kết thúc (nếu là một giai đoạn)
  isImportant Boolean   @default(false)

  // --- BỔ SUNG THÊM ---
  fileUrl  String? // Link tải file mẫu (Word, PDF...)
  fileName String? // Tên file hiển thị
  // --------------------

  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////
// NOTIFICATIONS (TỐI ƯU)
/////////////////////////////////////////////////
model Notification {
  id      Int     @id @default(autoincrement())
  title   String? // VD: "Đề tài được duyệt"
  content String
  link    String? // VD: "/student/my-project"
  isRead  Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

/////////////////////////////////////////////////
// TOPIC (LĨNH VỰC)
/////////////////////////////////////////////////
model Topic {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  projects  Project[]
  posts     Post[] // Nếu bạn muốn phân loại bài viết theo lĩnh vực
  createdAt DateTime  @default(now())
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/////////////////////////////////////////////////
// DỮ LIỆU ĐỘNG CHO CẨM NANG (GUIDE)
/////////////////////////////////////////////////

model ResearchGuide {
  id        Int     @id @default(autoincrement())
  mainTitle String
  subTitle  String? @db.Text

  // Lưu trữ cấu trúc phức tạp (Giai đoạn, Công cụ, Kỹ năng) dưới dạng JSON
  // Phù hợp để thay đổi số lượng các bước mà không cần sửa code
  steps  Json
  tools  Json
  skills Json

  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/////////////////////////////////////////////////
// TÌM ĐỒNG ĐỘI (RECRUITMENT) - YC 13 & 87
/////////////////////////////////////////////////

model Recruitment {
  id      Int      @id @default(autoincrement())
  title   String // VD: "Tìm 2 bạn mảng IoT cho đề tài nhà thông minh"
  content String   @db.Text
  skills  String[] // Các thẻ kỹ năng để lọc

  status RecruitmentStatus @default(OPEN)

  // SỬA TẠI ĐÂY: Xóa trường userId thừa, chỉ dùng authorId
  authorId Int
  author   User @relation("UserRecruitments", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

enum RecruitmentStatus {
  OPEN
  CLOSED
}

/////////////////////////////////////////////////
// ENUMS
/////////////////////////////////////////////////

enum Role {
  ADMIN
  LECTURER
  STUDENT
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

enum MemberRole {
  LEADER
  MEMBER
}

enum ResourceType {
  TEMPLATE
  GUIDE
  VIDEO
}

enum PostType {
  NEWS
  GUIDE
  ANNOUNCEMENT
}
